# ──────────────────────────────────────────────────────────────
#  Copy this file to .env.local and fill in your values.
#  .env.local is git-ignored — never commit real keys.
#  On Vercel, add the same variables under Project → Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────

# Your public site URL, no trailing slash. Used for canonical URLs, sitemap,
# robots.txt, Open Graph and JSON-LD. Use http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sanity (https://www.sanity.io/manage) ─────────────────────
# Project ID: shown on your project's page in sanity.io/manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Dataset name — "production" unless you created another one.
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: pin a Sanity API version (YYYY-MM-DD).
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Write token, used ONLY by the contact form API route to save submissions.
# Create it in sanity.io/manage → API → Tokens with "Editor" permissions.
# Server-only: never prefix this with NEXT_PUBLIC_.
SANITY_WRITE_TOKEN=

# ── Analytics (optional) ──────────────────────────────────────
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=
